---
import { getCollection, getEntry, render } from "astro:content";
import { Briefcase, GraduationCap } from "@lucide/astro";
import About from "../components/About.astro";
import Blog from "../components/Blog.astro";
import Contact from "../components/Contact.astro";
import Hackathons from "../components/Hackathons.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Timeline from "../components/Timeline.astro";
import Layout from "../layouts/Layout.astro";

const heroEntry = await getEntry("hero", "index");
const aboutEntry = await getEntry("about", "index");
const { Content: AboutContent } = await render(aboutEntry);
const generalEntry = await getEntry("general", "index");
const general = generalEntry.data;

const featuredProjects = general.showProjectsSection
	? (await getCollection("projects"))
			.filter((project) => project.data.featured)
			.sort((a, b) => {
				const orderDifference =
					(a.data.featuredOrder ?? Number.MAX_SAFE_INTEGER) -
					(b.data.featuredOrder ?? Number.MAX_SAFE_INTEGER);
				if (orderDifference !== 0) return orderDifference;
				return b.data.startDate.getTime() - a.data.startDate.getTime();
			})
			.slice(0, 3)
	: [];

const showExperience = general.showWorkSection || general.showEducationSection;
const firstFeaturedProject = featuredProjects[0] && {
	id: `project-${featuredProjects[0].id}`,
	label: "Selected work",
};
const primaryCta = [
	firstFeaturedProject,
	general.showAboutSection && { id: "about", label: "Explore about me" },
	showExperience && { id: "experience", label: "Explore experience" },
	general.showBlogSection && { id: "blog", label: "Read the blog" },
	general.showHackathonsSection && {
		id: "hackathons",
		label: "Explore hackathons",
	},
	general.showContactSection && { id: "contact", label: "Contact me" },
].find((destination): destination is { id: string; label: string } =>
	Boolean(destination),
);
---

<Layout
  title={`${heroEntry.data.name} | DevSecOps & Backend Engineer`}
  description="DevSecOps and Backend Engineering portfolio covering Secure SDLC, CI/CD security, REST APIs, Kubernetes, and automation."
>
  <main>
    <Hero
      hero={heroEntry.data}
      primaryCta={primaryCta}
      showContactCta={general.showContactSection && primaryCta?.id !== "contact"}
    />

    {
      general.showAboutSection && (
        <About
          title={aboutEntry.data.title}
          photo={aboutEntry.data.photo}
          Content={AboutContent}
          link={aboutEntry.data.link}
        />
      )
    }

    {general.showProjectsSection && <Projects projects={featuredProjects} />}

    {
      showExperience && (
        <div id="experience">
          {general.showWorkSection && (
            <Timeline
              collection="work"
              variant="timeline"
              color="primary"
              icon={Briefcase}
              sectionId="work-experience"
              sectionTitle="Work Experience"
            />
          )}

          {general.showEducationSection && (
            <Timeline
              collection="education"
              variant="list"
              color="secondary"
              backgroundColor="base-300"
              icon={GraduationCap}
              sectionTitle="Education"
            />
          )}
        </div>
      )
    }

    {general.showBlogSection && <Blog />}
    {general.showHackathonsSection && <Hackathons />}
    {general.showContactSection && <Contact />}
  </main>
</Layout>
