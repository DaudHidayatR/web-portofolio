---
import { getEntry, render } from "astro:content";
import { ArrowUpRight } from "@lucide/astro";
import { getIcon } from "../utils/iconMapper";
import SocialShare from "./SocialShare.astro";
const contactEntry = await getEntry("contact", "index");
const contact = contactEntry.data;
const { Content } = await render(contactEntry);
const heroEntry = await getEntry("hero", "index");
const profileLinks = heroEntry.data.socialLinks.filter(
	(link) => link.url !== contact.linkUrl,
);
const FooterIcon = getIcon(contact.footerIcon as any);
---
<footer id="contact" class="border-t editorial-rule px-4 py-20 sm:px-6 sm:py-24 lg:px-8" aria-labelledby="contact-title">
  <div class="mx-auto w-full max-w-7xl text-center"><p class="editorial-kicker">05 / Contact</p><h2 id="contact-title" class="mx-auto mt-3 max-w-3xl text-3xl font-bold tracking-tight text-balance sm:text-4xl">Let&apos;s build something secure.</h2><div class="prose editorial-secondary mx-auto mt-6 max-w-2xl"><Content /></div>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-2"><a href={contact.linkUrl} class="editorial-action">Email me<ArrowUpRight class="size-4" aria-hidden="true" /></a>{profileLinks.map((link) => { const IconComponent = getIcon(link.icon as any); return <a href={link.url} target="_blank" rel="noopener noreferrer" class="editorial-action-link"><IconComponent class="size-4" aria-hidden="true" />{link.label}</a>; })}</div>
    <div class="mt-10"><SocialShare /></div>
    <p class="editorial-muted mt-10 flex flex-wrap items-center justify-center gap-1 text-sm"><span>Copyright © {new Date().getFullYear()} — {contact.footerText}</span><a class="editorial-link inline-flex items-center" href={contact.footerLinkUrl} target="_blank" rel="noopener noreferrer"><FooterIcon class="mr-1 size-3" aria-hidden="true" />{contact.footerLinkText}</a></p>
  </div>
</footer>
