---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowRight } from "@lucide/astro";
import { getIcon } from "../utils/iconMapper";
import { parseInlineLinks } from "../utils/parseInlineLinks";
interface Props {
	hero: { name: string; title: string; description: string; avatar: ImageMetadata | string; location?: string; socialLinks: Array<{ url: string; icon: string; label: string; }>; };
	primaryCta?: { id: string; label: string; };
	showContactCta?: boolean;
}
const { hero, primaryCta, showContactCta = false } = Astro.props;
const capabilities = ["Secure SDLC", "Backend Systems", "Cloud & Kubernetes"];
---
<section id="home" class="snap-panel hero-panel px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="hero-title">
  <div class="mx-auto grid w-full max-w-7xl items-center gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:gap-16">
    <div class="max-w-3xl">
      <p class="editorial-kicker">{hero.title}</p>
      <h1 id="hero-title" class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight text-balance sm:text-6xl lg:text-7xl">DevSecOps and backend engineering, from code to production.</h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-base-content/75 sm:text-xl" set:html={parseInlineLinks(hero.description)} />
      <ul class="mt-7 flex flex-wrap border-y editorial-rule py-3 text-sm font-medium" aria-label="Core capabilities">{capabilities.map((capability) => <li class="border-r editorial-rule px-3 first:pl-0 last:border-0">{capability}</li>)}</ul>
      <div class="mt-9 flex flex-wrap gap-3">
        {primaryCta && <a href={`#${primaryCta.id}`} class="editorial-action">{primaryCta.label}<ArrowRight class="size-4" aria-hidden="true" /></a>}
        {showContactCta && <a href="#contact" class="editorial-action-secondary">Contact me</a>}
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
        {hero.socialLinks.map((link) => { const IconComponent = getIcon(link.icon as any); return <a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined} class="editorial-link inline-flex items-center gap-2 text-sm" aria-label={link.label}><IconComponent class="size-4" aria-hidden="true" />{link.label}</a>; })}
        {hero.location && <span class="text-sm text-base-content/65">{hero.location}</span>}
      </div>
    </div>
    <figure class="mx-auto w-full max-w-sm lg:max-w-md">
      <div class="editorial-frame">
        {typeof hero.avatar === "string" ? <img src={hero.avatar} alt={hero.name} class="aspect-[4/5] h-full w-full object-cover object-top" width="480" height="600" loading="eager" decoding="async" fetchpriority="high" data-image-component /> : <Image src={hero.avatar} alt={hero.name} class="aspect-[4/5] h-full w-full object-cover object-top" width={480} height={600} loading="eager" decoding="async" fetchpriority="high" data-image-component />}
      </div>
      <figcaption class="border-b editorial-rule py-3"><span class="block font-semibold">{hero.name}</span><span class="text-sm text-base-content/65">{hero.title}</span></figcaption>
    </figure>
  </div>
</section>
