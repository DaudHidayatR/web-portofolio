---
import { Menu } from "@lucide/astro";
import ThemeController from "./ThemeController.svelte";
interface NavLink {
	id: string;
	label: string;
}
interface Props {
	links: NavLink[];
}
const { links } = Astro.props;
const anchorPrefix = Astro.url.pathname === "/" ? "" : "/";
const sectionHref = (id: string) => `${anchorPrefix}#${id}`;
---
<header class="sticky top-0 z-50 border-b editorial-rule bg-base-100 pt-[env(safe-area-inset-top)]">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6 lg:px-8">
    <a href={sectionHref("home")} class="text-lg font-bold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary" aria-label="DaudHR home">Daud<span class="text-primary">HR</span></a>
    {links.length > 0 && <nav aria-label="Primary navigation" class="ml-auto hidden items-center gap-6 md:flex">{links.map((link) => <a href={sectionHref(link.id)} class="editorial-link text-sm no-underline">{link.label}</a>)}</nav>}
    <div class="ml-auto flex items-center gap-1 md:ml-2">
      <ThemeController client:load />
      {links.length > 0 && <details class="relative md:hidden">
        <summary class="flex size-10 list-none items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" aria-label="Open navigation menu"><Menu class="size-5" aria-hidden="true" /></summary>
        <ul class="absolute right-0 z-50 mt-2 w-52 border editorial-rule bg-base-100 p-2">{links.map((link) => <li><a href={sectionHref(link.id)} class="block px-3 py-2 focus-visible:outline-2 focus-visible:outline-primary">{link.label}</a></li>)}</ul>
      </details>}
    </div>
  </div>
</header>
