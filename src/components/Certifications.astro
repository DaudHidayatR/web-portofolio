---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";

const certifications = (await getCollection("certifications")).sort(
	(a, b) => b.data.issuedDate.getTime() - a.data.issuedDate.getTime(),
);

function formatIssuedDate(issuedDate: Date) {
	return issuedDate.toLocaleDateString("en-US", {
		month: "short",
		year: "numeric",
	});
}
---

<section
  id="certifications"
  class="flow-section border-t editorial-rule bg-base-200 px-4 py-16 sm:px-6 sm:py-20 lg:px-8"
  aria-labelledby="certifications-title"
>
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto mb-10 max-w-4xl text-center">
      <p class="editorial-kicker">05 / Certifications</p>
      <h2 id="certifications-title" class="mt-2 text-4xl font-bold">
        Certifications
      </h2>
      <p class="editorial-secondary mt-2">
        Formal training and professional credentials in DevSecOps, cloud, AI, and IT support.
      </p>
    </div>

    <ul class="mx-auto max-w-4xl overflow-hidden border editorial-rule bg-base-100 text-left">
      {certifications.map((certification) => (
        <li class="border-b editorial-rule last:border-b-0">
          <article class="grid gap-3 p-5 sm:grid-cols-[1fr_auto] sm:items-start sm:p-6">
            <div class="min-w-0">
              <div class="flex items-start gap-4">
                {certification.data.logo && (
                  <div class="flex size-14 shrink-0 items-center justify-center rounded-box border editorial-rule bg-base-200 p-2">
                    <Image
                      src={certification.data.logo}
                      alt={certification.data.issuer}
                      inferSize={true}
                      loading="lazy"
                      decoding="async"
                      class="max-h-full w-full object-contain"
                    />
                  </div>
                )}
                <div class="min-w-0">
                  <h3 class="text-lg font-bold">{certification.data.title}</h3>
                  <p class="text-primary font-semibold text-sm">
                    {certification.data.issuer}
                  </p>
                  {certification.data.skills &&
                    certification.data.skills.length > 0 && (
                      <ul
                        class="editorial-secondary mt-3 flex flex-wrap gap-x-2 text-sm"
                        aria-label={`${certification.data.title} topics`}
                      >
                        {certification.data.skills.map((skill, index) => (
                          <li>
                            {skill}
                            {index <
                              (certification.data.skills?.length ?? 0) - 1 && (
                              <span class="editorial-muted ml-2">/</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between gap-4 sm:flex-col sm:items-end">
              <time
                datetime={certification.data.issuedDate
                  .toISOString()
                  .slice(0, 7)}
                class="text-base-content/70 font-mono text-sm italic"
              >
                {formatIssuedDate(certification.data.issuedDate)}
              </time>
              {certification.data.credentialUrl && (
                <a
                  href={certification.data.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="editorial-action-link"
                  aria-label={`View ${certification.data.title} credential`}
                >
                  View credential
                  <ArrowUpRight class="size-4" aria-hidden="true" />
                </a>
              )}
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
